{
  "port": 8787,
  "data_dir": "./data",
  "allowed_origins": ["https://bridge.example.com", "http://localhost:5173"],
  "repos": [
    { "name": "sh-game", "path": "D:/repos/sh-game", "project_key": "SH" },
    { "name": "shared-tools", "path": "D:/repos/shared-tools", "project_key": null }
  ],
  "projects": ["SH"],
  "max_concurrency": 2,
  "task_timeout_minutes": 60,
  "heartbeat_seconds": 15,
  "heartbeat_lost_seconds": 45,
  "assign_start_timeout_seconds": 60,
  "wake_debounce_seconds": 10,
  "orch_tick_minutes": 10,
  "jira_poll_seconds": 60,
  "agent_label": "agent",
  "claude_auth_mode": "subscription",
  "jira_create_tool_pattern": "(^|__)(create_issue|jira_create_issue|createJiraIssue|create_jira_issue)$",
  "jira_env_file": "D:/secrets/team-jira.env",
  "claude_executable": null,
  "planner": {
    "mcp_servers": {
      "jira": {
        "command": "uvx",
        "args": ["mcp-atlassian"],
        "env": { "JIRA_URL": "https://jira.example.com", "JIRA_PERSONAL_TOKEN": "<PAT>", "JIRA_SSL_VERIFY": "true" }
      }
    },
    "allowed_tools": ["mcp__jira__jira_search", "mcp__jira__jira_get_*"],
    "system_prompt_append": null,
    "model": null,
    "setting_sources": []
  },
  "orchestrators": {
    "SH": {
      "cwd": "./orchestrators/SH",
      "mcp_servers": {
        "jira": {
          "command": "uvx",
          "args": ["mcp-atlassian"],
          "env": {
            "JIRA_URL": "https://jira.example.com",
            "JIRA_PERSONAL_TOKEN": "<PAT>",
            "JIRA_SSL_VERIFY": "true",
            "READ_ONLY_MODE": "true"
          }
        }
      },
      "allowed_tools": ["mcp__jira__jira_search", "mcp__jira__jira_get_*"],
      "system_prompt_append": null,
      "model": null,
      "setting_sources": ["project"]
    }
  },
  "orchestrator_autostart": true,
  "pairing_token": null,
  "runner_bootstrap_token": null
}
