{
  "name": "claude-bridge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "dev:backend": "pnpm --filter @claude-bridge/backend dev",
    "dev:runner": "pnpm --filter @claude-bridge/runner dev",
    "dev:web": "pnpm --filter @claude-bridge/web dev"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2",
    "@types/node": "^22.10.0"
  }
}
