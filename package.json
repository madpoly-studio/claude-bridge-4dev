{
  "name": "claude-bridge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:e2e": "vitest run --config e2e/vitest.config.ts",
    "test:scripts": "node --test scripts/mps-bridge/test/",
    "dev:backend": "tsx watch packages/backend/src/index.ts",
    "dev:runner": "tsx packages/runner/src/index.ts",
    "dev:web": "pnpm --filter @claude-bridge/web dev",
    "start:backend": "node packages/backend/dist/index.js",
    "start:runner": "node packages/runner/dist/index.js"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2",
    "@types/node": "^22.10.0"
  }
}
